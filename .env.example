# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
DATABASE_URL="postgresql://your-db-user:your-db-password@localhost:5432/your-database-name?schema=public"

# JWT Configuration
JWT_SECRET=your-jwt-secret-minimum-32-characters-required
JWT_EXPIRES_IN=your-jwt-expiry

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket-name

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
WHISPER_API_KEY=your-whisper-api-key

# AssemblyAI
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ASSEMBLYAI_WEBHOOK_SECRET=your-assemblyai-webhook-secret   # Used for HMAC verification
ASSEMBLYAI_SPEECH_MODELS=your-assemblyai-speech-models
COACHING_MODEL=your-coaching-openai-model



# App
WEBHOOK_BASE_URL=https://your-public-base-url.example
# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email - Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=your-sender@example.com
EMAIL_FROM_NAME=your-sender-display-name

# Monitoring Configuration (Optional)
DISABLE_S3_HEALTH_CHECK=false
DISABLE_OPENAI_HEALTH_CHECK=false
ENABLE_SESSION_TRANSCRIPT_DEBUG=true



OPENAI_MODEL=your-openai-model-name

# Interview analysis (long transcripts)
# Max estimated input tokens for single-pass (tier S); above uses map-reduce when enabled
ANALYSIS_TIER_S_MAX_INPUT_TOKENS=5000
# Bumped when prompts change (idempotency / cache keys)
ANALYSIS_PROMPT_VERSION=1
# Enable map-reduce path for transcripts above tier S threshold
ENABLE_LONG_TRANSCRIPT_PIPELINE=true


#Stripe Billing
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_ID=your-stripe-price-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=your-stripe-billing-portal-configuration-id

STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.example/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-app.example/billing/canceled
STRIPE_BILLING_PORTAL_RETURN_URL=https://your-app.example/billing

STRIPE_PUBLIC_APP_BASE_URL=https://your-app.example